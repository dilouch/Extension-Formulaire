{
    "source": {
        "include": ["src/"],
        "includePattern": ".+\\.js$"
    },
    "opts": {
        "destination": "./docs/",
        "recurse": true
    },
    "plugins": ["plugins/markdown"],
    "templates": {
        "cleverLinks": false,
        "monospaceLinks": false
    },
    "metadata": {
        "title": "DevSource Autofill Messages — Documentation"
    }
}
